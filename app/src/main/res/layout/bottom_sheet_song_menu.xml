<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:background="?attr/colorSurface">

    <!-- Header with song info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="?attr/colorSurfaceContainer">

        <ImageView
            android:id="@+id/sheetAlbumArt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/default_album_art"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/sheetSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/song_title"
                android:textStyle="bold"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:id="@+id/sheetSongArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/song_artist"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Actions -->
    <TextView
        android:id="@+id/actionAddToFavorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_to_favorites"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:drawablePadding="24dp"
        app:drawableStartCompat="@drawable/ic_favorite_border_24"
        app:drawableTint="?attr/colorOnSurface"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/actionAddToPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_to_playlist"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_playlist_play_24"
        app:drawableTint="?attr/colorOnSurface"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/actionRemoveFromPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remove_from_playlist"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:padding="16dp"
        android:drawablePadding="24dp"
        app:drawableStartCompat="@drawable/ic_delete_24"
        app:drawableTint="?attr/colorOnSurface"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"/>

</LinearLayout>
